// Baseline for docs/**/*.md, README.md, CONTRIBUTING.md.
// Aligns with docs/meta/index.md: heading ladder and link quality matter;
// line length, pseudo-headings, and intentional HTML anchors stay relaxed for this corpus.
// MD025 off: Meta allows title in YAML plus one in-body # for agent-first pages.
// docs/algorea/** is imported technical content and keeps its original HTML markup.
{
  "config": {
    "default": true,
    "MD013": false,
    "MD025": false,
    "MD033": {
      "allowed_elements": ["a"]
    },
    "MD036": false,
    "MD048": false,
    "MD049": false,
    "MD060": false
  },
  "globs": ["docs/**/*.md", "README.md", "CONTRIBUTING.md"],
  "ignores": ["docs/algorea/**"]
}
